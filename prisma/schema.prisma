generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         String      @default("MEMBER")
  isDemo       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  custodians   Custodian[]
  loans        Loan[]      @relation("BorrowerLoans")
  auditLogs    LoanEvent[] @relation("ActorAuditLogs")
}

model CatalogueItem {
  id          String      @id @default(uuid())
  code        String      @unique
  title       String
  category    String
  description String?
  isArchived  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  custodians  Custodian[]
  loans       Loan[]
}

model Custodian {
  id        String        @id @default(uuid())
  userId    String
  itemId    String
  createdAt DateTime      @default(now())
  item      CatalogueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Loan {
  id             String        @id @default(uuid())
  itemId         String
  borrowerId     String
  status         String        @default("REQUESTED")
  requestedDate  DateTime      @default(now())
  issuedDate     DateTime?
  dueDate        DateTime?
  returnedDate   DateTime?
  notes          String?
  alertDismissed Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  borrower       User          @relation("BorrowerLoans", fields: [borrowerId], references: [id])
  item           CatalogueItem @relation(fields: [itemId], references: [id])
  events         LoanEvent[]
}

model LoanEvent {
  id        String   @id @default(uuid())
  loanId    String
  actorId   String
  action    String
  notes     String?
  timestamp DateTime @default(now())
  actor     User     @relation("ActorAuditLogs", fields: [actorId], references: [id])
  loan      Loan     @relation(fields: [loanId], references: [id])
}
