generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         String      @default("MEMBER") // "LIBRARIAN" or "MEMBER"
  isDemo       Boolean     @default(false) // Restricted "demo" librarian: full visibility, no approval rights, member names hidden
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  loans        Loan[]      @relation("BorrowerLoans")
  custodians   Custodian[] 
  auditLogs    LoanEvent[] @relation("ActorAuditLogs")
}

model CatalogueItem {
  id          String      @id @default(uuid())
  code        String      @unique
  title       String
  category    String
  description String?
  isArchived  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  custodians  Custodian[]
  loans       Loan[]
}

model Custodian {
  id        String        @id @default(uuid())
  userId    String
  itemId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      CatalogueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, itemId])
}

model Loan {
  id             String      @id @default(uuid())
  itemId         String
  borrowerId     String
  status         String      @default("REQUESTED") // "REQUESTED", "ISSUED", "RETURNED", "LOST", "DECLINED"
  requestedDate  DateTime    @default(now())
  issuedDate     DateTime?
  dueDate        DateTime?
  returnedDate   DateTime?
  notes          String?
  alertDismissed Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  item           CatalogueItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  borrower       User          @relation("BorrowerLoans", fields: [borrowerId], references: [id], onDelete: Restrict)
  events         LoanEvent[]
}

model LoanEvent {
  id        String     @id @default(uuid())
  loanId    String
  actorId   String
  action    String     // "REQUESTED", "ISSUED", "RETURNED", "LOST", "DECLINED", "ALERT_DISMISSED", "NOTE_ADDED"
  notes     String?
  timestamp DateTime   @default(now())

  loan      Loan       @relation(fields: [loanId], references: [id], onDelete: Restrict)
  actor     User       @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: Restrict)
}
